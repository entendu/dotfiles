# gsync <branch>: checkout, pull upstream, push origin
gsync() {
    if [[ -z "$1" ]]; then echo "usage: gsync <branch>" >&2; return 1; fi
    if ! git branch --list "$1" | grep -q .; then echo "branch $1 does not exist" >&2; return 1; fi
    git checkout "$1" && git pull upstream "$1" && git push origin "$1"
}

# knownrm <line>: delete a line from ~/.ssh/known_hosts
knownrm() {
    if [[ ! "$1" =~ ^[0-9]+$ ]]; then echo "usage: knownrm <line-number>" >&2; return 1; fi
    sed -i '' "${1}d" ~/.ssh/known_hosts
}

# denter <container>: exec into a running docker container
denter() {
    if [[ -z "$1" ]]; then echo "usage: denter <container>" >&2; return 1; fi
    docker exec -it "$1" bash
}

# mkcd <dir>: mkdir and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# extract <archive>: unpack anything
extract() {
    if [[ ! -f "$1" ]]; then echo "'$1' is not a file" >&2; return 1; fi
    case "$1" in
        *.tar.bz2|*.tbz2) tar xjf "$1" ;;
        *.tar.gz|*.tgz)   tar xzf "$1" ;;
        *.tar.xz|*.txz)   tar xJf "$1" ;;
        *.tar)            tar xf  "$1" ;;
        *.bz2)            bunzip2 "$1" ;;
        *.gz)             gunzip  "$1" ;;
        *.zip)            unzip   "$1" ;;
        *.7z)             7z x    "$1" ;;
        *) echo "don't know how to extract '$1'" >&2; return 1 ;;
    esac
}
